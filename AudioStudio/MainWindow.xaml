<Window x:Class="AudioStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AudioStudio"
        xmlns:controls="clr-namespace:AudioStudio.Controls"
        xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
        xmlns:views="clr-namespace:AudioStudio.Views"
        Title="BF^Studio" 
        Height="800" Width="1400"
        MinHeight="1" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="Transparent">

    <WindowChrome.WindowChrome>
        <WindowChrome CornerRadius="0" 
                      GlassFrameThickness="0" 
                      ResizeBorderThickness="8"
                      CaptionHeight="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="MenuButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FF9A9AA8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TransportButton" TargetType="Button">
            <Setter Property="Background" Value="#FF3A3A42"/>
            <Setter Property="Foreground" Value="#FFDDDDDD"/>
            <Setter Property="BorderBrush" Value="#FF4E4E58"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF484852"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#FF7881FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF32323A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlayButton" TargetType="Button">
            <Setter Property="Background" Value="#FF7881FF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF8E97FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF929BFF"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#FFA8AFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF626BDB"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#FF7881FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#FF4A4A54"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#FF555560"/>
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StopButton" TargetType="Button">
            <Setter Property="Background" Value="#FF383840"/>
            <Setter Property="Foreground" Value="#FFCCCCCC"/>
            <Setter Property="BorderBrush" Value="#FF5A5A66"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF44444E"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#FF7881FF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF2E2E36"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#FF626BDB"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFAAAAAA"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF3E3E46"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#FF55556A"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF4A4A66"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#FF7881FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Background" Value="#FF5E67E0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF7881FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF7881FF"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#FF929BFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF525AD4"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#FF626BDB"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#FF3E3E48"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#FF4A4A54"/>
                                <Setter Property="Foreground" Value="#FF888888"/>
                                <Setter Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Background" Value="#FF38383E"/>
            <Setter Property="Foreground" Value="#FFBBBBBB"/>
            <Setter Property="BorderBrush" Value="#FF4A4A52"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF44444C"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#FF6B72B8"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF32323A"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#FF7881FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FF888888"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BrowserItem" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFCCCCCC"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF3E3E42"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF4A4F7A"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowChromeIcon" TargetType="fa:IconBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
        </Style>

        <Style x:Key="WindowButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFAAAAAA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF2E2E38"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF252530"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource WindowButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#C50F1F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>

        <!-- Полный стиль TreeViewItem без проблемных биндингов -->
        <Style TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- Невидимый GridSplitter -->
        <Style x:Key="InvisibleSplitter" TargetType="GridSplitter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="6"/>
            <Setter Property="Template" Value="{x:Null}"/>
        </Style>
    </Window.Resources>

    <!-- Основной контейнер для перекрытия системной линии -->
    <Border Background="#FF2D2D30">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="0"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Resize сверху -->
            <Border Grid.Row="0" Background="Transparent" Cursor="SizeNS"
                    MouseLeftButtonDown="Window_MouseLeftButtonDown" Tag="Top"/>
            
            <!-- Resize справа -->
            <Border Grid.Row="1" Grid.RowSpan="3" Width="6" HorizontalAlignment="Right" Background="Transparent" 
                    Cursor="SizeWE" MouseLeftButtonDown="Window_MouseLeftButtonDown" Tag="Right"/>
            
            <!-- Resize снизу -->
            <Border Grid.Row="3" Height="6" VerticalAlignment="Bottom" Background="Transparent" 
                    Cursor="SizeNS" MouseLeftButtonDown="Window_MouseLeftButtonDown" Tag="Bottom"/>
            
            <!-- Resize угол -->
            <Border Grid.Row="3" Width="6" Height="6" HorizontalAlignment="Right" VerticalAlignment="Bottom" 
                    Background="Transparent" Cursor="SizeNWSE" MouseLeftButtonDown="Window_MouseLeftButtonDown" Tag="BottomRight"/>

            <!-- Заголовок -->
            <Border Grid.Row="1" Background="#FF1A1A2E" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Height="32">
                    <!-- Меню -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="6,0,0,0">
                        <Button Content="File" Style="{StaticResource MenuButton}" Click="OpenFile_Click"/>
                        <Button Content="Hotkeys" Style="{StaticResource MenuButton}" Click="ShowHotkeys_Click"/>
                        <Button Content="Instruments" Style="{StaticResource MenuButton}" Click="ApplyEffects_Click"/>
                        <Button Content="Help" Style="{StaticResource MenuButton}"/>
                    </StackPanel>

                    <!-- Логотип (центр): B = bloom, note = музыка -->
                    <TextBlock FontFamily="{StaticResource BnoteFont}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center">
                        <Run Text="B" Foreground="#FF7881FF"/>
                        <Run Text="note" Foreground="#FFE8E8EC"/>
                    </TextBlock>

                    <!-- Кнопки управления окном -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Stretch">
                        <Button Style="{StaticResource WindowButton}" Click="Minimize_Click" ToolTip="Свернуть">
                            <Viewbox Width="10" Height="10" Stretch="Uniform">
                                <fa:IconBlock Icon="WindowMinimize" Style="{StaticResource WindowChromeIcon}"/>
                            </Viewbox>
                        </Button>
                        <Button x:Name="MaximizeBtn" Style="{StaticResource WindowButton}" Click="Maximize_Click" ToolTip="Развернуть">
                            <Viewbox Width="10" Height="10" Stretch="Uniform">
                                <fa:IconBlock x:Name="MaximizeIcon" Icon="WindowMaximize" Style="{StaticResource WindowChromeIcon}"/>
                            </Viewbox>
                        </Button>
                        <Button Style="{StaticResource CloseButton}" Click="Close_Click" ToolTip="Закрыть">
                            <Viewbox Width="10" Height="10" Stretch="Uniform">
                                <fa:IconBlock Icon="Xmark" Style="{StaticResource WindowChromeIcon}"/>
                            </Viewbox>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Основная область -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" MinWidth="150" x:Name="BrowserColumn"/>
                <ColumnDefinition Width="4"/>
                <!-- Разделитель -->
                <ColumnDefinition Width="*" MinWidth="200"/>
            </Grid.ColumnDefinitions>

            <!-- Левая панель - Браузер файлов -->
            <Border Grid.Column="0" Background="#FF252526">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Поле пути + Фильтры -->
                    <Grid Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#FF1E1E1E" Padding="8,6" BorderBrush="#FF3E3E42" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="📍" Foreground="#FF888888" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox Grid.Column="1" x:Name="CurrentPathBox" Text="C:\\" 
                                         Background="#FF1E1E1E" Foreground="#FFCCCCCC" 
                                         BorderThickness="0" FontSize="11" VerticalContentAlignment="Center"
                                         IsReadOnly="True"/>
                                <Button Grid.Column="2" Content="📂" Style="{StaticResource ToolButton}" Width="28" Height="22" Click="BrowseRootFolder_Click" ToolTip="Выбрать папку"/>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Background="#FF2D2D30" Padding="8,4" BorderBrush="#FF3E3E42" BorderThickness="0,0,0,1">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BtnAll" Content="All" Style="{StaticResource TabButton}" Click="FilterAll_Click"/>
                                <Button x:Name="BtnDownloads" Content="Downloads" Style="{StaticResource TabButton}" Click="FilterDownloads_Click" Foreground="White"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Дерево папок и файлов -->
                    <Border Grid.Row="1" Background="#FF252526" BorderBrush="#FF3E3E42" BorderThickness="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="#FF2D2D30" Padding="8,4" BorderBrush="#FF3E3E42" BorderThickness="0,0,0,1">
                                <TextBlock Text="Files" Foreground="#FFFFFFFF" FontSize="10" FontWeight="SemiBold"/>
                            </Border>
                            <TreeView Grid.Row="1" x:Name="FolderTree" Background="#FF252526" Foreground="White" 
                                      BorderThickness="0" FontSize="11" Padding="4" Margin="0,4,0,0"
                                      HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"
                                      SelectedItemChanged="FolderTree_SelectedItemChanged"
                                      MouseDoubleClick="FolderTree_MouseDoubleClick">
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                        <StackPanel Orientation="Horizontal">
                                            <fa:IconBlock Icon="{Binding Icon}" Foreground="#FFAAAAAA" Margin="0,0,6,0" FontSize="12"/>
                                            <TextBlock Text="{Binding DisplayName}" Foreground="White"/>
                                            <TextBlock Text="{Binding Duration}" Foreground="#FF888888" FontSize="9" Margin="8,0,0,0"
                                                       Visibility="{Binding IsDirectory, Converter={StaticResource InverseBoolToVis}}"/>
                                        </StackPanel>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Разделитель между браузером и треками -->
            <Border Grid.Column="1" Background="#FF3E3E42" 
                    MouseLeftButtonDown="Splitter_MouseLeftButtonDown"
                    Cursor="SizeWE"/>

            <!-- Основная рабочая область -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="24"/>  <!-- TimeRuler -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Transport и инструменты -->
                <Border Grid.Row="0" Background="#FF323233" Padding="10,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Transport -->
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BtnPlay" Style="{StaticResource PlayButton}" Click="Play_Click" IsEnabled="False">
                                <fa:IconBlock Icon="Play" Foreground="White" FontSize="16"/>
                            </Button>
                            <Button x:Name="BtnStop" Style="{StaticResource StopButton}" Click="Stop_Click" IsEnabled="False" Margin="5,0,0,0">
                                <fa:IconBlock Icon="Stop" Foreground="#FFCCCCCC" FontSize="13"/>
                            </Button>
                            <Button x:Name="BtnLoop" Style="{StaticResource ToolButton}" Click="LoopToggle_Click" Margin="8,0,0,0" ToolTip="Зациклить">
                                <fa:IconBlock Icon="RotateRight" Foreground="#FFAAAAAA" FontSize="14"/>
                            </Button>
                        </StackPanel>

                        <!-- Инструменты -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="20,0">
                            <Button Style="{StaticResource ToolButton}" Click="Cut_Click" IsEnabled="False" x:Name="BtnCut" ToolTip="Вырезать">
                                <fa:IconBlock Icon="Scissors" Foreground="#FFAAAAAA" FontSize="14"/>
                            </Button>
                            <Button Style="{StaticResource ToolButton}" Click="Copy_Click" IsEnabled="False" x:Name="BtnCopy" ToolTip="Копировать">
                                <fa:IconBlock Icon="Copy" Foreground="#FFAAAAAA" FontSize="14"/>
                            </Button>
                            <Button Style="{StaticResource ToolButton}" Click="Paste_Click" IsEnabled="False" x:Name="BtnPaste" ToolTip="Вставить">
                                <fa:IconBlock Icon="Paste" Foreground="#FFAAAAAA" FontSize="14"/>
                            </Button>
                            <Button Style="{StaticResource ToolButton}" Click="Delete_Click" IsEnabled="False" x:Name="BtnDelete" ToolTip="Удалить">
                                <fa:IconBlock Icon="TrashCan" Foreground="#FFAAAAAA" FontSize="14"/>
                            </Button>

                            <Rectangle Width="1" Fill="#FF555555" Margin="10,0"/>

                            <Button Style="{StaticResource ToolButton}" Click="Undo_Click" x:Name="BtnUndo" ToolTip="Отменить">
                                <fa:IconBlock Icon="ArrowRotateLeft" Foreground="#FFAAAAAA" FontSize="14"/>
                            </Button>
                            <Button Style="{StaticResource ToolButton}" Click="Redo_Click" x:Name="BtnRedo" ToolTip="Вернуть">
                                <fa:IconBlock Icon="ArrowRotateRight" Foreground="#FFAAAAAA" FontSize="14"/>
                            </Button>

                            <Rectangle Width="1" Fill="#FF555555" Margin="10,0"/>

                            <Button Style="{StaticResource ToolButton}" Click="ToggleView_Click" ToolTip="Вид: спектрограмма" x:Name="BtnToggleView">
                                <fa:IconBlock Icon="WaveSquare" Foreground="#FFAAAAAA" FontSize="14"/>
                            </Button>
                            <Button Style="{StaticResource ToolButton}" ToolTip="Соло">
                                <fa:IconBlock Icon="Headphones" Foreground="#FFAAAAAA" FontSize="14"/>
                            </Button>
                            <Button Style="{StaticResource ToolButton}" ToolTip="Мьют">
                                <fa:IconBlock Icon="VolumeOff" Foreground="#FFAAAAAA" FontSize="14"/>
                            </Button>
                        </StackPanel>

                        <!-- КнопкиApply -->
                        <StackPanel Grid.Column="3" Orientation="Horizontal">
                            <Button Content="+ Track" Style="{StaticResource AccentButton}" Click="AddTrack_Click" Margin="0,0,5,0"/>
                            <Button Content="- Delete" Style="{StaticResource ToolbarButton}" Click="RemoveTrack_Click"/>
                            <Button Content="Clear" Style="{StaticResource ToolbarButton}" Click="ClearTrack_Click" ToolTip="Очистить трек" Margin="5,0,0,0"/>
                            <Button Content="✓ Apply" Style="{StaticResource AccentButton}" x:Name="BtnApply" Click="ApplyEffects_Click" IsEnabled="False" Margin="5,0,0,0"/>
                            <Button Content="G ↓" Style="{StaticResource ToolbarButton}" ToolTip="Группировать" Margin="5,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- TimeRuler с подсветкой выделения -->
                <Border Grid.Row="1" Background="#FF232323" BorderBrush="#FF3E3E42" BorderThickness="0,0,0,1">
                    <controls:TimeRuler x:Name="TimeRulerControl"/>
                </Border>

                <!-- Playlist (FL Studio style) -->
                <Grid Grid.Row="2">
                    <views:PlaylistView x:Name="PlaylistViewControl"/>

                    <!-- Hidden waveform tracks for backward compat -->
                    <Border x:Name="TracksBorder" Visibility="Collapsed" AllowDrop="True">
                        <ScrollViewer x:Name="TracksScroller" ScrollChanged="TracksScroller_ScrollChanged">
                            <Grid x:Name="TracksContainer">
                                <StackPanel x:Name="TracksPanel"/>
                            </Grid>
                        </ScrollViewer>
                    </Border>

                    <Canvas x:Name="SelectionCanvas" Visibility="Collapsed"
                            IsHitTestVisible="False"/>
                </Grid>
            </Grid>
        </Grid>

        <!-- Нижняя панель - Статус -->
        <Border Grid.Row="3" Background="#FF323233" Padding="15,8" BorderBrush="#FF3E3E42" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Статус: кольцо + скрытая подпись «Готово» (для доступности) -->
                <StackPanel Orientation="Horizontal">
                    <Grid x:Name="ActivityRing" Width="28" Height="28" VerticalAlignment="Center" Cursor="Hand"
                          Margin="0,0,6,0" ClipToBounds="False"
                          MouseEnter="SpinnerGrid_MouseEnter" MouseLeave="SpinnerGrid_MouseLeave">
                        <Ellipse x:Name="RingBg" Width="22" Height="22" Stroke="#FF555555" StrokeThickness="2.5" Fill="Transparent"/>
                        <Path x:Name="RingProgress" Stroke="#FF7881FF" StrokeThickness="3" Fill="Transparent"
                              Stretch="None" Visibility="Collapsed"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Grid>
                    <TextBlock x:Name="StatusText" Text="Готово" Visibility="Collapsed" Width="0" Height="0"
                               AutomationProperties.Name="Готово"/>
                </StackPanel>

                <!-- Инфотип Popup -->
                <Popup x:Name="ActivityPopup" Placement="Top" PlacementTarget="{Binding ElementName=ActivityRing}"
                       StaysOpen="True" AllowsTransparency="True" PopupAnimation="Fade"
                       IsOpen="False">
                    <Border Background="#FF2D2D30" BorderBrush="#FF3E3E42" BorderThickness="1"
                            CornerRadius="4" Padding="14,10" MinWidth="200">
                        <StackPanel>
                            <TextBlock x:Name="PopupTitle" Text="" Foreground="#FFCCCCCC" FontSize="11"/>
                            <TextBlock x:Name="PopupDescription" Text="" Foreground="#FF888888" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Popup>

                <!-- Время -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,20,0">
                    <TextBlock x:Name="CurrentTimeText" Text="00:00:00" Foreground="#FF7881FF" FontSize="14" FontFamily="Consolas" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text=" / " Foreground="#FF666666" FontSize="14" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TotalTimeText" Text="00:00:00" Foreground="#FF888888" FontSize="14" FontFamily="Consolas" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Масштаб -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="-" Style="{StaticResource ToolButton}" Click="ZoomOut_Click" Width="25" Height="22"/>
                    <Slider x:Name="ZoomSlider" Minimum="10" Maximum="500" Value="100" Width="100" ValueChanged="ZoomSlider_Changed" VerticalAlignment="Center"/>
                    <Button Content="+" Style="{StaticResource ToolButton}" Click="ZoomIn_Click" Width="25" Height="22"/>
                    <TextBlock x:Name="ZoomValue" Text="100%" Foreground="#FF888888" FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Border>
</Window>